{
  "name": "rate-limiter-api",
  "version": "1.0.0",
  "description": "Express API demonstrating custom rate limiting algorithms and storage strategies",
  "main": "src/server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "start:memory": "STORAGE=memory node src/server.js",
    "start:sqlite": "STORAGE=sqlite node --disable-warning=ExperimentalWarning src/server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.0"
  }
}
